<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG builds only. This file overrides
  src/main/res/xml/network_security_config.xml for the `debug` build type,
  permitting plain-HTTP (cleartext) sync to any host so a LAN sync server
  can be reached without TLS while developing / testing on a real device.

  Release builds are unaffected: the production config stays HTTPS-only
  (cleartext denied except loopback), and this file is never part of a
  release APK. It also still needs `WB_ALLOW_INSECURE_SYNC=1` at
  `cap sync` time — see capacitor.config.ts.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
